# n8n Configuration - Based on Docker Compose setup
N8N_HOST=0.0.0.0
N8N_PORT=5678
N8N_PROTOCOL=https
N8N_RUNNERS_ENABLED=true
NODE_ENV=production

# Database Configuration (set to postgresdb for persistence and fast cold starts)
DB_TYPE=postgresdb
# Postgres connection (fill these with your DB values)
DB_POSTGRESDB_HOST=/cloudsql/betterprep-main-account:us-central1:n8n-postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n-postgres
DB_POSTGRESDB_USER=postgres
DB_POSTGRESDB_PASSWORD=Tanmay@Betterprep2112
DB_POSTGRESDB_SCHEMA=public

# Cloud SQL Connector
CLOUDSQL_INSTANCE=betterprep-main-account:us-central1:n8n-postgres

# Authentication
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD="M#x46$LZ&fUtc2u"

# Security
N8N_ENCRYPTION_KEY=2d51aedbfbffe89d9ad53182bd966398
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true

GCLOUD_CLIENT_SECRET=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

# Timezone
