# n8n Configuration - Based on Docker Compose setup
N8N_HOST=0.0.0.0
N8N_PORT=5678
N8N_PROTOCOL=https
N8N_RUNNERS_ENABLED=true
NODE_ENV=production

# Database Configuration
DB_TYPE=sqlite
DB_SQLITE_DATABASE=/tmp/n8n.db
DB_SQLITE_POOL_SIZE=3

# Authentication
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD="M#x46$LZ&fUtc2u"

# Security
N8N_ENCRYPTION_KEY=2d51aedbfbffe89d9ad53182bd966398
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true

# Timezone
GENERIC_TIMEZONE=UTC
TZ=UTC

# Webhook Configuration (will be set dynamically)
WEBHOOK_URL=https://n8n-serverless-1069021792204.us-central1.run.app/
N8N_EDITOR_BASE_URL=https://n8n-serverless-1069021792204.us-central1.run.app

# GCP Configuration
PROJECT_ID=betterprep-main-account
REGION=us-central1
SERVICE_NAME=n8n-serverless
