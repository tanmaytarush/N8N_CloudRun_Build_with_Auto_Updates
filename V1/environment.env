# N8N V1 Environment Configuration
# Copy this file and modify the values as needed

# GCP Configuration
export PROJECT_ID=$(gcloud config get-value project)
export REGION=us-central1
export SERVICE_NAME=n8n-v1

# N8N Configuration
export N8N_HOST=0.0.0.0
export N8N_PORT=5678
export N8N_PROTOCOL=https
export N8N_BASIC_AUTH_ACTIVE=true
export N8N_BASIC_AUTH_USER=tanmay@betterprep.ai
export N8N_BASIC_AUTH_PASSWORD=M#x46$$LZ&fUtc2u

# Database Configuration
export DB_TYPE=sqlite
export DB_SQLITE_POOL_SIZE=10
export DB_SQLITE_VACUUM_ON_STARTUP=false

# Security Configuration
export N8N_ENCRYPTION_KEY=2d51aedbfbffe89d9ad53182bd966398
export N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=false

# Feature Flags
export N8N_RUNNERS_ENABLED=true
export N8N_DISABLE_UI=false
export N8N_DISABLE_PRODUCTION_MAIN_PROCESS=false
export N8N_BLOCK_ENV_ACCESS_IN_NODE=false
export N8N_SKIP_WEBHOOK_DEREGISTRATION_SHUTDOWN_PROCESS=true

# URLs (Update these with your actual service URL after deployment)
export N8N_EDITOR_BASE_URL=https://n8n-serverless-1069021792204.us-central1.run.app
export N8N_WEBHOOK_URL=https://n8n-serverless-1069021792204.us-central1.run.app

# Timezone
export GENERIC_TIMEZONE=UTC
export TZ=UTC
